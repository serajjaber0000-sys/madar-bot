{
  "appId": "com.madar.health",
  "appName": "مدار",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F1117",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "backgroundColor": "#0F1117",
      "style": "DARK",
      "overlapsWebView": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0F1117"
  }
}
